{
  "id": "content-in-parts.v1",
  "status": "design-preview-not-compiler-integrated",
  "name": "Viens slaids, vairākas daļas",
  "entry": "template.html",
  "logicalViewport": {
    "width": 1280,
    "height": 800
  },
  "scaling": "uniform-contain",
  "slots": [
    {
      "name": "title",
      "required": true
    },
    {
      "name": "parts",
      "required": true
    },
    {
      "name": "partNavigation",
      "required": true
    },
    {
      "name": "visual",
      "required": true
    }
  ],
  "allowedExtras": [],
  "overflowPolicy": "report-do-not-shrink-text",
  "contentChanges": "require-source-approval",
  "assets": [
    "../../assets/template.css",
    "../../assets/preview-runtime.js",
    "../../assets/raleway-variable.ttf"
  ],
  "notes": "Proposed contract. Current preview supplies sample content; production slot binding and compiler validation are not implemented.",
  "state": {
    "part": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "initial": 1
    }
  },
  "navigation": {
    "mode": "set-part",
    "controls": "stable data-control-id",
    "preserveAllSourceText": true,
    "remoteSyncImplemented": false
  },
  "visualPolicy": {
    "maxConsecutiveTextOnlySlides": 2,
    "denseContentRequiresAdjacentVisual": true,
    "isDenseContent": true,
    "sequenceValidationImplemented": false
  },
  "contentBalance": {
    "textShare": 0.55,
    "visualShare": 0.45,
    "textShareRange": [
      0.5,
      0.6
    ],
    "visualShareRange": [
      0.4,
      0.5
    ],
    "overflow": "use-more-parts-not-smaller-fonts"
  }
}
