{
  "_read": "The one file to read to choose and fill a screen. Each blueprint: what information it is for, where its slots sit (grid areas, one letter a slot), what fills each slot, and its live reference. Slots are one of six kinds. The words in a slot always come from the approved content script; the pictures from the build sheet. The empty layouts are design/template-blueprints/index.html (scripts/blueprints.py writes it from this file).",
  "kinds": {
    "Title": "the screen's title or question - script title / question",
    "Text": "approved words that teach - script text and the template's own fields",
    "Info": "what the room reads at a glance - chips, numbers, a table, readings, a list to tick, the choices' marks",
    "Picture": "a photograph, a static 3D render or a 2D-kit figure - build sheet figure; never the old flat line drawing (L67)",
    "Animation": "something that moves by itself - a simulator screen, a clock, a meter, a flow",
    "3D": "a live 3D scene the room turns - build sheet figure (*.kit3d.json)"
  },
  "rules": [
    "pick by the information: the first blueprint whose 'for' matches it (script/GUIDE.md section 1 says how to write its fields)",
    "never the same look twice in a row (L62); each picture by the picture rule (L67, course-visuals SKILL.md)",
    "a task screen: the factory picks the Navy or the white theme so neighbouring screens do not repeat",
    "a self-check of five: three of the richest tasks (3D, animation, a control panel), two basic (match, order, choose)",
    "a picture beside words comes in four boxes - text-wide 40 %, even 45 %, picture-wide 58 %, picture-large 65 % of the width (layout-templates.json \"boxes\"): the compiler gives the picture the box its names need and the words what is left, in parts when they do not fit; a picture no box beside its words can show goes on the stage alone or is made another kind of picture (in steps, a 3D model with names on tap) - never squeezed. A build sheet may name one: \"box\""
  ],
  "refs": {
    "slides": "design/slide-templates/presentation/index.html#<id>",
    "live": "design/task-templates/live/index.html#<id>",
    "engines": "design/task-templates/engines/demo/tasks/<id>.html (themes: design/task-templates/themes.py; shots: design/task-templates/shots/)"
  },
  "slides": [
    {"id": "explain-figure.figure-right", "for": "a picture and a short explanation", "grid": ["x p"], "cols": "45fr 55fr", "fill": {"x": ["Text", "text, up to 60 words"], "p": ["3D", "figure: a 3D model, or a photo"]}, "ref": "slides#p4"},
    {"id": "explain-figure.figure-left", "mirror": "explain-figure.figure-right", "fill_note": "build sheet figure_first"},
    {"id": "explain-figure.text-only", "for": "a short slide with no picture (at most two in a row)", "grid": ["x"], "fill": {"x": ["Text", "text, up to 60 words"]}},
    {"id": "figure-stage.figure", "for": "a large picture with few words", "grid": ["p", "x"], "rows": "3fr 1fr", "fill": {"p": ["3D", "figure"], "x": ["Text", "text, up to 45 words"]}, "ref": "slides#p3"},
    {"id": "figure-stage.two", "for": "two pictures to compare, each with its words", "grid": ["p q", "x y"], "rows": "3fr 2fr", "fill": {"p": ["Picture", "figure"], "q": ["Picture", "figure_b"], "x": ["Text", "blocks[0] lines"], "y": ["Text", "blocks[1] lines"]}, "ref": "slides#p6"},
    {"id": "figure-stage.figure-top", "for": "a photograph across the slide, the words under it", "grid": ["p p", "x y"], "rows": "3fr 2fr", "fill": {"p": ["Picture", "figure (a photograph)"], "x": ["Text", "text, first half"], "y": ["Text", "text, second half"]}},
    {"id": "photo-explain.full", "for": "a real photograph that is the lesson", "bg": "p", "grid": ["x ."], "cols": "40fr 60fr", "fill": {"p": ["Picture", "figure (a photograph); spots {line: [x, y]}"], "x": ["Text", "text, up to 50 words"]}, "ref": "slides#p1"},
    {"id": "photo-explain.split", "for": "a photograph beside its words", "grid": ["x p"], "cols": "50fr 50fr", "fill": {"x": ["Text", "text, up to 50 words"], "p": ["Picture", "figure (a photograph); zoom {line: [x, y, scale]}"]}, "ref": "slides#p9"},
    {"id": "photo-explain.column", "for": "a photograph in its own column, more words", "grid": ["x p"], "cols": "55fr 45fr", "fill": {"x": ["Text", "text, up to 85 words"], "p": ["Picture", "figure; composition wide-left"]}},
    {"id": "compare-two.two-visuals", "for": "two things side by side, each named and boxed", "grid": ["p q", "x y"], "rows": "1fr 1fr", "fill": {"p": ["Picture", "figure"], "q": ["Picture", "figure_b"], "x": ["Text", "blocks[0]: its name, then boxed lines"], "y": ["Text", "blocks[1]"]}, "ref": "slides#p14"},
    {"id": "procedure.with-figure", "for": "numbered steps beside a picture", "grid": ["x p"], "cols": "50fr 50fr", "fill": {"x": ["Text", "lines 1 ..., 2 ..., 3 ..."], "p": ["3D", "figure"]}},
    {"id": "procedure.figure-left", "mirror": "procedure.with-figure"},
    {"id": "procedure.text-only", "for": "numbered steps with no picture: step boxes", "grid": ["a b c d"], "fill": {"a": ["Text", "step 1"], "b": ["Text", "step 2"], "c": ["Text", "step 3"], "d": ["Text", "step 4 (up to 4 a row)"]}, "ref": "slides#p11"},
    {"id": "three-content-blocks.with-figure", "for": "three parts of one system", "grid": ["a p", "b p", "c p"], "cols": "40fr 60fr", "fill": {"a": ["Text", "blocks[0]"], "b": ["Text", "blocks[1]"], "c": ["Text", "blocks[2]"], "p": ["3D", "one live scene; its reading"]}, "ref": "slides#p12"},
    {"id": "three-content-blocks.figure-left", "mirror": "three-content-blocks.with-figure"},
    {"id": "reference-table.with-figure", "for": "rows of values with a conclusion", "grid": ["i p", "x p"], "cols": "55fr 45fr", "rows": "3fr 1fr", "fill": {"i": ["Info", "lines 'cell | cell'"], "x": ["Text", "the line after the rows"], "p": ["Picture", "figure"]}, "ref": "slides#p13"},
    {"id": "reference-table.figure-left", "mirror": "reference-table.with-figure"},
    {"id": "reading-with-figure.figure-right", "for": "a lot of text beside a picture (60-85 words)", "grid": ["x p"], "cols": "55fr 45fr", "fill": {"x": ["Text", "text, up to 85 words"], "p": ["Picture", "figure; a line and its part light together"]}, "ref": "slides#p8"},
    {"id": "reading-with-figure.figure-left", "mirror": "reading-with-figure.figure-right"},
    {"id": "content-in-parts.with-figure", "for": "more words than one view holds", "grid": ["x p", "i p"], "cols": "45fr 55fr", "rows": "5fr 1fr", "fill": {"x": ["Text", "text in parts of about 75 words"], "i": ["Info", "the parts' tabs"], "p": ["3D", "figure"]}, "ref": "slides#p10"},
    {"id": "content-in-parts.figure-left", "mirror": "content-in-parts.with-figure"},
    {"id": "long-explanation.model", "for": "a long explanation of a shape in space", "grid": ["x p"], "cols": "42fr 58fr", "fill": {"x": ["Text", "text"], "p": ["3D", "a 3D model, 58 % of the width"]}, "ref": "slides#p7"},
    {"id": "long-explanation.figure-left", "mirror": "long-explanation.model"},
    {"id": "long-explanation.points", "for": "a long explanation - short points, the full words for the instructor", "grid": ["x p"], "cols": "42fr 58fr", "fill": {"x": ["Text", "points: 3-5, 14 words or fewer"], "p": ["3D", "figure"]}, "notes": "text goes to the notes", "ref": "slides#p25"},
    {"id": "worked-example.figure", "for": "a calculation or a reading", "grid": ["x p"], "cols": "46fr 54fr", "fill": {"x": ["Text", "steps 'what you do | what you get'; ask; reveal"], "p": ["Animation", "figure: a meter, a 3D model or a photo"]}, "ref": "slides#p19"},
    {"id": "worked-example.text-only", "for": "a calculation with no picture", "grid": ["x"], "fill": {"x": ["Text", "steps; ask; reveal"]}},
    {"id": "true-false.picture", "for": "a common wrong belief", "grid": ["x p", "i p"], "cols": "48fr 52fr", "rows": "2fr 1fr", "fill": {"x": ["Text", "claim; then why (text)"], "i": ["Info", "True / False vote, the stamp"], "p": ["Picture", "figure"]}, "ref": "slides#p20"},
    {"id": "true-false.text-only", "for": "a wrong belief, no picture", "grid": ["x", "i"], "fill": {"x": ["Text", "claim; why"], "i": ["Info", "vote"]}},
    {"id": "scenario.picture-left", "for": "what to do when something happens", "grid": ["p x", "p i"], "cols": "50fr 50fr", "rows": "1fr 2fr", "fill": {"p": ["Picture", "figure"], "x": ["Text", "the situation (text); ask"], "i": ["Info", "choices A-C, why each after Next"]}, "ref": "slides#p21"},
    {"id": "scenario.text-only", "for": "a situation with no picture", "grid": ["x", "i"], "fill": {"x": ["Text", "situation; ask"], "i": ["Info", "choices"]}},
    {"id": "name-parts.picture", "for": "parts of equipment taught earlier", "grid": ["x p"], "cols": "38fr 62fr", "fill": {"x": ["Text", "ask; the names (text), hidden until Next"], "p": ["Picture", "figure with numbered spots"]}, "ref": "slides#p22"},
    {"id": "key-numbers.cards", "for": "several limits or values", "grid": ["a b c", "d e f"], "fill": {"a": ["Info", "value | what it means"], "b": ["Info", "..."], "c": ["Info", "..."], "d": ["Info", "..."], "e": ["Info", "..."], "f": ["Info", "3-8 cards"]}, "ref": "slides#p23"},
    {"id": "before-after.slider", "for": "two states of the same thing", "grid": ["p x"], "cols": "58fr 42fr", "fill": {"p": ["Picture", "figure | figure_b, a slider between"], "x": ["Text", "'A | B', then 'what | in A | in B'"]}, "ref": "slides#p24"},
    {"id": "drill.quick-fire", "for": "before the module check: quick recall", "grid": ["x", "a"], "rows": "4fr 1fr", "fill": {"x": ["Text", "lines 'prompt | answer', one at a time"], "a": ["Animation", "the bar runs out, seconds"]}, "ref": "slides#p27"},
    {"id": "drill.say-it", "for": "before the module check: say the actions aloud", "grid": ["p x", "p a"], "cols": "52fr 48fr", "fill": {"p": ["Picture", "figure"], "x": ["Text", "situation; ask; reveal after the clock"], "a": ["Animation", "the clock"]}, "ref": "slides#p26"},
    {"id": "drill.find-it", "for": "before the module check: find it on the photo", "bg": "p", "grid": ["x .", "a ."], "cols": "40fr 60fr", "fill": {"p": ["Picture", "figure; spots"], "x": ["Text", "lines 'Point to ...'"], "a": ["Animation", "the clock"]}, "ref": "slides#p28"},
    {"id": "recap.cards", "for": "the end of the module", "grid": ["a b", "c d"], "fill": {"a": ["Text", "asks[0], then line 1"], "b": ["Text", "asks[1], line 2"], "c": ["Text", "..."], "d": ["Text", "3-6 cards"]}, "ref": "slides#p17"},
    {"id": "opening.statement", "for": "the module's first slide", "grid": ["x"], "fill": {"x": ["Text", "title large, lines"]}, "ref": "slides#p2"},
    {"id": "opening.photo", "for": "the module's first slide on a photograph", "bg": "p", "grid": ["x ."], "cols": "50fr 50fr", "fill": {"p": ["Picture", "figure"], "x": ["Text", "title, lines"]}},
    {"id": "task-launch.tablet", "for": "a task slide (a self-check)", "grid": ["x p", "i p"], "cols": "50fr 50fr", "rows": "3fr 1fr", "fill": {"x": ["Text", "code, title, text"], "i": ["Info", "chips: minutes, questions, alone or team; before (2-4 ticks)"], "p": ["Picture", "the exercise's photo, else the tablet render"]}, "ref": "slides#p16"},
    {"id": "task-launch.room", "for": "a room activity", "grid": ["x"], "fill": {"x": ["Text", "code, title, how the room works"]}},
    {"id": "task-launch.check", "for": "the module check", "grid": ["x", "i"], "fill": {"x": ["Text", "MC, title, text"], "i": ["Info", "the module's topics ticked off"]}, "ref": "slides#p18"}
  ],
  "tasks": [
    {"id": "first-try", "for": "the course's first task: tap, move", "grid": ["t t", "a b"], "fill": {"t": ["Title", "fixed words"], "a": ["Info", "tap"], "b": ["Info", "move it into the box"]}, "ref": "live#s1"},
    {"id": "choose-one", "for": "single_choice, with how sure", "grid": ["p t", "p x", "p i"], "cols": "45fr 55fr", "fill": {"p": ["Picture", "the question's picture (3D or photo)"], "t": ["Title", "question"], "x": ["Text", "options A-D"], "i": ["Info", "how sure"]}, "ref": "live#s2"},
    {"id": "choose-all-pictures", "for": "multi_select whose answers are things to recognise", "grid": ["t t t t", "a b c d"], "fill": {"t": ["Title", "question"], "a": ["Picture", "option A: build sheet figures {words: picture}"], "b": ["Picture", "option B"], "c": ["Picture", "option C"], "d": ["Picture", "option D"]}, "ref": "live#s3"},
    {"id": "true-false-cards", "for": "true_false", "grid": ["t t t", "i p j"], "cols": "1fr 6fr 1fr", "fill": {"t": ["Title", "question"], "p": ["Picture", "each card: build sheet figures {claim: picture}, the claim (Text) on it"], "i": ["Info", "False side"], "j": ["Info", "True side"]}, "ref": "live#s4"},
    {"id": "order", "for": "order", "grid": ["t t", "i x"], "fill": {"t": ["Title", "question"], "i": ["Info", "the numbered places on one rail"], "x": ["Text", "the steps, an icon each"]}, "ref": "live#s5"},
    {"id": "match", "for": "match", "grid": ["t t", "p x"], "fill": {"t": ["Title", "question"], "p": ["Picture", "left: the names (and the question's picture)"], "x": ["Text", "right: what each does, joined by a line"]}, "ref": "live#s6"},
    {"id": "tap-the-place", "for": "hotspot, label_diagram", "grid": ["p t", "p x"], "cols": "60fr 40fr", "fill": {"p": ["3D", "an unlabelled 3D render or photo"], "t": ["Title", "question"], "x": ["Text", "how to answer"]}, "ref": "live#s7"},
    {"id": "read-the-instrument", "for": "read_instrument", "grid": ["a t", "a x"], "cols": "45fr 55fr", "fill": {"a": ["Animation", "the instrument: bezel, glass, needle"], "t": ["Title", "question"], "x": ["Text", "options"]}, "ref": "live#s8"},
    {"id": "spot-the-errors", "for": "spot_the_error", "grid": ["t p", "x p"], "cols": "40fr 60fr", "fill": {"t": ["Title", "question"], "x": ["Text", "how to answer"], "p": ["Picture", "the real document on paper"]}, "ref": "live#s9"},
    {"id": "scenario", "for": "scenario", "grid": ["p t", "p i", "p x"], "cols": "50fr 50fr", "fill": {"p": ["Picture", "the picture follows each step"], "t": ["Title", "question"], "i": ["Info", "the situation as a log line"], "x": ["Text", "choices"]}, "ref": "live#s10"},
    {"id": "set-the-value", "for": "set_value", "grid": ["d t", "d x"], "cols": "45fr 55fr", "fill": {"d": ["Animation", "the dial: the knob that turns, the number, the slider"], "t": ["Title", "question"], "x": ["Text", "how to answer"]}, "ref": "live#s11"},
    {"id": "result", "for": "the end of a set", "grid": ["a i", "a x"], "cols": "40fr 60fr", "fill": {"a": ["Animation", "the score ring"], "i": ["Info", "a line per topic"], "x": ["Text", "certain but wrong: where the debrief starts"]}, "ref": "live#s12"},
    {"id": "live-system", "for": "operate the simulator's cargo screen", "frame": "engine", "fill": {"s": ["Animation", "the simulator screen (gb_hmi)"], "i": ["Info", "readings, the link, now"]}, "ref": "engines#01_live_system"},
    {"id": "keep-safe", "for": "hold a value inside its band over time", "frame": "engine", "fill": {"s": ["Animation", "the simulator and its trend"], "i": ["Info", "the leg, the readings, now"]}, "ref": "engines#02_keep_safe"},
    {"id": "predict-curve", "for": "predict, then see", "frame": "engine", "fill": {"s": ["Animation", "the chart to draw on"], "i": ["Info", "the case (3D card), your prediction"]}, "ref": "engines#03_predict_curve"},
    {"id": "survey-space", "for": "test an atmosphere point by point", "frame": "engine", "fill": {"s": ["Picture", "the space, its points"], "i": ["Info", "the meter's display, readings"]}, "ref": "engines#04_survey_space"},
    {"id": "draw-route", "for": "draw the way out", "frame": "engine", "fill": {"s": ["Picture", "the ship from above"], "i": ["Info", "the door, the route"]}, "ref": "engines#05_draw_route"},
    {"id": "lay-out", "for": "place the equipment, mind the wind - built by the factory: lay_out (a framed task)", "frame": "engine", "fill": {"s": ["Picture", "the deck from above"], "i": ["Info", "on deck now, the tray"]}, "ref": "engines#06_lay_out"},
    {"id": "ppe-buddy", "for": "dress for a job, then check a colleague - built by the factory: dress_for_job (a framed task)", "frame": "engine", "fill": {"s": ["Picture", "the colleague"], "i": ["Info", "the rack"]}, "ref": "engines#07_ppe_buddy"},
    {"id": "triage", "for": "put people where they matter", "frame": "engine", "fill": {"s": ["Picture", "the ship, the events"], "i": ["Info", "the crew, the panel"]}, "ref": "engines#08_triage"},
