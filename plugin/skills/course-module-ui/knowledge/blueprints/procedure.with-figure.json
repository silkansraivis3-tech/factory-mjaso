{
 "id": "procedure.with-figure",
 "template": "procedure",
 "variant": "with-figure",
 "shape": "beside",
 "for": "numbered steps beside a picture",
 "grid": ["x p"],
 "cols": "50fr 50fr",
 "fill": {"x": ["Text", "lines 1 ..., 2 ..., 3 ..."], "p": ["3D", "figure"]},
 "fits": {"group": "steps", "pictures": ["drawing", "3d", "photo"], "aspect": {"drawing": [0.8, 2.2], "3d": [0.8, 2.2], "tiles": [0.5, 4], "photo": [0.6, 1.3]}, "words": [0, 999], "budget": {"drawing": "beside_picture", "3d": "beside_3d", "photo": "beside_picture"}}
}
