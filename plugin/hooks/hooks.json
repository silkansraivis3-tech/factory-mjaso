{
  "description": "L40: the master folder's source files, knowledge base and old course are read only",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_writes.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
